# Python
__pycache__/
*.py[cod]
*$py.class
.so
.pytest_cache/
.venv/
venv/
*.egg-info/

# Test / coverage output
coverage/
htmlcov/

# C / C++ build artifacts
build/
bin/
obj/
out/
*.o
*.a
*.exe
*.out
.dsa/build/
# Per-exercise clangd/IDE flags, generated by whichever tool opens the exercise.
compile_flags.txt

# Local database & state
.dsa/*.db
.dsa/*.db-journal
.dsa/*.db-wal
.dsa/*.db-shm

# Frontend / Node.js
# A bare directory pattern matches at any depth, so this also covers
# frontend/node_modules/. Do not re-add the scoped form: it is redundant, and having
# both has caused this line to conflict across branches more than once.
node_modules/
frontend/.vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# TypeScript incremental build cache; regenerated by `tsc -b`.
*.tsbuildinfo

# Environment & OS
.env
.env.local
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
scratch/

