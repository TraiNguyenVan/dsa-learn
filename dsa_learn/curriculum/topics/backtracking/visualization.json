            "kind": "list",
            "values": [
              4,
              5
            ]
          },
          "params": {
            "target": 9
          }
        },
        {
          "name": "All Duplicates",
          "description": "Boundary: equal values, multiple index pairs, one value sum.",
          "input": {
            "kind": "list",
            "values": [
