{
  "operations": [
    {
      "id": "dp_table_fill",
      "name": "DP Table Fill",
      "description": "Writes each state once, showing exactly which cells it reads from.",
      "data_structure_type": "DP_TABLE",
      "parameters": [
        {
          "name": "target",
          "label": "Target",
          "type": "number",
          "default_value": 7,
          "min": 0,
          "max": 60
        }
      ],
      "presets": [
        {
          "name": "Standard Coins",
          "description": "Coins 1, 3, 4 to amount 7.",
          "input": {
            "kind": "list",
            "values": [
              1,
              3,
              4
            ]
          },
          "params": {
            "target": 7
          }
        },
        {
          "name": "No Solution",
          "description": "Boundary: unreachable amount, so the final cell stays null.",
          "input": {
            "kind": "list",
            "values": [
              4,
              6
            ]
          },
          "params": {
            "target": 5
          }
        },
        {
          "name": "Zero Target",
          "description": "Boundary: the base case alone.",
          "input": {
            "kind": "list",
            "values": [
              1,
              3,
              4
            ]
          },
          "params": {
            "target": 0
          }
        },
        {
          "name": "Empty Input",
          "description": "Boundary: no coins, degenerate table.",
          "input": {
            "kind": "list",
            "values": []
          },
          "params": {
            "target": 5
          }
        },
        {
          "name": "Single Coin",
          "description": "Boundary: one row of transitions.",
          "input": {
            "kind": "list",
            "values": [
              5
            ]
          },
          "params": {
            "target": 10
          }
        },
        {
          "name": "Already Ordered",
          "description": "Boundary: ascending coin values.",
          "input": {
            "kind": "list",
            "values": [
              1,
              2,
              3,
              4,
              5
            ]
          },
          "params": {
            "target": 9
          }
        },
        {
          "name": "All Duplicates",
          "description": "Boundary: repeated coin values, redundant rows.",
          "input": {
            "kind": "list",
            "values": [
              3,
              3,
              3
            ]
          },
          "params": {
            "target": 9
          }
        }
      ]
    }
  ]
}
